{
  "name": "compyle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:test": "firebase emulators:exec --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "emulator": "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
