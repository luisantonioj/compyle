# ─── Firebase ──────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your Firebase project values.
# Get these from: Firebase Console → Project Settings → Your Apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only Firebase service account credentials for Vercel cron.
# Keep these out of client bundles and local commits.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── FCM (Push Notifications) ──────────────────────────────────────────────────
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Key pair
VITE_FCM_VAPID_KEY=

# ─── Vercel Cron (notification dispatch) ──────────────────────────────────────
# Set this to a long random secret, then add it in Vercel Environment Variables too
CRON_SECRET=

# ─── Local development flags ───────────────────────────────────────────────────
# Set to "true" to use Firebase Emulator Suite instead of live Firebase
VITE_USE_EMULATOR=false
