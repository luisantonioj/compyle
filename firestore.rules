rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Checks whether a confirmed partnership exists between the requester and uid.
    // Partnership is stored as partnerId field on each user's profile doc.
    function isLinkedPartner(uid) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(uid)).data.get('partnerId', null) == request.auth.uid;
    }

    // Returns the tracker_visibility/settings doc for a user.
    function visibility(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/tracker_visibility/settings).data;
    }

    // ── User profile ──────────────────────────────────────────────────────
    // Partners may read the profile (display name, avatar) but never write it.
    match /users/{uid} {
      allow read:   if isOwner(uid) || isLinkedPartner(uid);
      allow write:  if isOwner(uid);
      // Cross-user partnerId writes for linking and unlinking:
      // Link:   acceptor sets inviter's partnerId to their own UID (inviter had no partner)
      // Unlink: linked partner clears the other's partnerId back to null
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerId'])
        && (
          (resource.data.get('partnerId', null) == null
           && request.resource.data.partnerId == request.auth.uid)
          || (resource.data.get('partnerId', null) == request.auth.uid
              && request.resource.data.get('partnerId', null) == null)
        );
    }

    // ── Tasks ─────────────────────────────────────────────────────────────
    match /users/{uid}/tasks/{docId} {
      allow read:  if isOwner(uid)
                   || (isLinkedPartner(uid) && visibility(uid).tasks == true);
      allow write: if isOwner(uid) || isLinkedPartner(uid);
    }

    // ── Habits ────────────────────────────────────────────────────────────
    match /users/{uid}/habits/{docId} {
      allow read:  if isOwner(uid)
                   || (isLinkedPartner(uid) && visibility(uid).habits == true);
      allow write: if isOwner(uid) || isLinkedPartner(uid);
    }

    // ── Bank accounts (categories stored as array inside doc) ─────────────
    match /users/{uid}/bank_accounts/{docId} {
      allow read:  if isOwner(uid)
                   || (isLinkedPartner(uid) && visibility(uid).budget == true);
      allow write: if isOwner(uid) || isLinkedPartner(uid);
    }

    // ── Transactions ──────────────────────────────────────────────────────
    match /users/{uid}/transactions/{docId} {
      allow read:  if isOwner(uid)
                   || (isLinkedPartner(uid) && visibility(uid).budget == true);
      allow write: if isOwner(uid) || isLinkedPartner(uid);
    }

    // ── Bills (recurring_payments) ────────────────────────────────────────
    match /users/{uid}/recurring_payments/{docId} {
      allow read:  if isOwner(uid)
                   || (isLinkedPartner(uid) && visibility(uid).payments == true);
      allow write: if isOwner(uid) || isLinkedPartner(uid);
    }

    // ── Debts (pending_payments) ──────────────────────────────────────────
    match /users/{uid}/pending_payments/{docId} {
      allow read:  if isOwner(uid)
                   || (isLinkedPartner(uid) && visibility(uid).payments == true);
      allow write: if isOwner(uid) || isLinkedPartner(uid);
    }

    // ── Tracker visibility (privacy settings) ─────────────────────────────
    // Partners cannot read privacy settings — only the owner controls them.
    match /users/{uid}/tracker_visibility/{docId} {
      allow read, write: if isOwner(uid);
    }

    // ── Push subscriptions & notification settings ────────────────────────
    // Strictly owner-only — never exposed to partners.
    match /users/{uid}/push_subscriptions/{docId} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid}/notification_settings/{docId} {
      allow read, write: if isOwner(uid);
    }

    // ── Device push tokens (top-level, public read) ───────────────────────
    // Stores the Web Push subscription JSON + pre-computed daily summary.
    // Public read is safe: the subscription endpoint can only be used to send
    // a notification if the sender holds the VAPID private key.
    match /device_tokens/{uid} {
      allow read:  if true;
      allow write: if isOwner(uid);
    }

    // ── Partner invites ───────────────────────────────────────────────────
    // Document ID is a random 6-char code; inviterId is stored as a field.
    // Any signed-in user can read (to accept) and delete (acceptor cleans up).
    match /partner_invites/{code} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.inviterId == request.auth.uid;
      allow delete: if isSignedIn();
    }

  }
}
